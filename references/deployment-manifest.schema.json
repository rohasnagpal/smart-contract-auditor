{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rohasnagpal:solidity-builder-auditor:deployment-manifest:1.1.0",
  "title": "Solidity Builder Auditor Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentReady",
    "releaseId",
    "createdAt",
    "scope",
    "contract",
    "sources",
    "build",
    "target",
    "constructor",
    "files",
    "dependencies",
    "commands",
    "findings",
    "cleanRoomRebuild",
    "missingArtifacts",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "deploymentReady": { "type": "boolean" },
    "releaseId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "sourceCommit", "includedContracts", "excludedPaths"],
      "properties": {
        "scopeId": { "type": "string", "minLength": 1 },
        "sourceCommit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "includedContracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourcePath", "sourceSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilerVersion", "evmVersion", "optimizer", "viaIR", "compilerInputSha256", "artifactSha256", "creationBytecodeSha256", "deployedBytecodeSha256"],
      "properties": {
        "compilerVersion": { "type": "string", "minLength": 1 },
        "evmVersion": { "type": "string", "minLength": 1 },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "runs"],
          "properties": {
            "enabled": { "type": "boolean" },
            "runs": { "type": "integer", "minimum": 0 }
          }
        },
        "viaIR": { "type": "boolean" },
        "compilerInputSha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "creationBytecodeSha256": { "$ref": "#/$defs/sha256" },
        "deployedBytecodeSha256": { "$ref": "#/$defs/sha256" },
        "linkReferences": { "type": "object" },
        "immutableReferences": { "type": "object" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "evmVersion"],
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "evmVersion": { "type": "string", "minLength": 1 },
        "nativeCurrency": { "type": "string", "minLength": 1 }
      }
    },
    "constructor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "parameters"],
      "properties": {
        "signature": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "solidityType"],
            "properties": {
              "name": { "type": "string" },
              "solidityType": { "type": "string", "minLength": 1 },
              "value": {}
            }
          }
        },
        "encodedArgsSha256": { "$ref": "#/$defs/sha256" },
        "initCodeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialOwner": { "type": "string" },
        "postDeploymentProcedure": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "remapping"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "remapping": { "type": ["string", "null"] }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "test", "analyze"],
      "properties": {
        "build": { "$ref": "#/$defs/commands" },
        "test": { "$ref": "#/$defs/commands" },
        "analyze": { "$ref": "#/$defs/optionalCommands" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "classification", "verification", "resolution"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
          "classification": { "enum": ["Confirmed finding", "Potential issue", "Design consideration", "Analyzer false positive"] },
          "verification": { "enum": ["Code review", "Confirmed by test/trace", "Needs confirmation", "Not applicable"] },
          "resolution": { "enum": ["Open", "Resolved", "Partially resolved", "Unresolved", "Accepted risk"] },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionMaker", "decidedAt", "rationale"],
            "properties": {
              "decisionMaker": { "type": "string", "minLength": 1 },
              "decidedAt": { "type": "string", "format": "date-time" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["resolution"],
              "properties": { "resolution": { "const": "Accepted risk" } }
            },
            "then": { "required": ["acceptance"] }
          }
        ]
      }
    },
    "cleanRoomRebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "comparedArtifacts"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["Pass", "Fail", "Not tested"] },
        "comparedArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "missingArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": {
        "required": ["deploymentReady"],
        "properties": { "deploymentReady": { "const": true } }
      },
      "then": {
        "properties": {
          "constructor": {
            "required": ["encodedArgsSha256", "initCodeSha256"],
            "properties": {
              "parameters": {
                "items": { "required": ["name", "solidityType", "value"] }
              }
            }
          },
          "files": {
            "required": [
              "SPEC.md",
              "abi.json",
              "audit-report.md",
              "build-artifact.json",
              "compiler-input.json",
              "constructor-args.hex",
              "constructor-schema.json",
              "creation-bytecode.hex",
              "deployed-bytecode.hex",
              "deployment-manifest.schema.json",
              "deployment-values.json",
              "init-code.hex",
              "remediation-history.md",
              "traceability.json"
            ]
          },
          "cleanRoomRebuild": {
            "properties": { "result": { "const": "Pass" } }
          },
          "missingArtifacts": { "maxItems": 0 },
          "findings": {
            "items": {
              "allOf": [
                { "properties": { "classification": { "const": "Confirmed finding" } } },
                { "properties": { "verification": { "enum": ["Code review", "Confirmed by test/trace"] } } },
                {
                  "if": {
                    "required": ["severity"],
                    "properties": { "severity": { "enum": ["Critical", "High"] } }
                  },
                  "then": { "properties": { "resolution": { "const": "Resolved" } } }
                },
                {
                  "if": {
                    "required": ["severity"],
                    "properties": { "severity": { "enum": ["Medium", "Low"] } }
                  },
                  "then": { "properties": { "resolution": { "enum": ["Resolved", "Accepted risk"] } } }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "optionalCommands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
